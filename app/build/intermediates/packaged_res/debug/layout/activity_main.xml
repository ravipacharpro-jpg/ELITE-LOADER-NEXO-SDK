<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#061426">

    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/bg_dashboard_art" android:scaleType="centerCrop"
        android:contentDescription="" />
    <View android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/dash_topshade" />

    <!-- Single screen. No ScrollView: the card wraps its content, leaving background visible below. -->
    <LinearLayout android:id="@+id/dashboard_root" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="vertical"
        android:paddingStart="15dp" android:paddingEnd="15dp"
        android:paddingTop="10dp" android:paddingBottom="77dp">

        <LinearLayout android:id="@+id/dashboard_header" android:layout_width="match_parent"
            android:layout_height="44dp" android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView android:layout_width="40dp" android:layout_height="40dp"
                android:src="@drawable/ic_elite_symbol" android:scaleType="fitCenter"
                android:contentDescription="Logo" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Elite Tool" android:textColor="#FFFFFF"
                    android:textSize="21sp" android:fontFamily="sans-serif-black"
                    android:singleLine="true" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="P R E M I U M   T O O L S" android:textSize="8sp"
                    android:textColor="#64D9FF" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/dashboard_intro" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">
            <View android:layout_width="30dp" android:layout_height="3dp"
                android:layout_marginTop="8dp" android:background="#1ABEFF" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="7dp" android:text="Choose a game"
                android:textSize="24sp" android:textStyle="bold" android:textColor="#FFFFFF"
                android:singleLine="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:id="@+id/dashboard_subtitle" android:text="Swipe left or right to select your game"
                android:textSize="11sp" android:textColor="#BED7EC" android:singleLine="true" />
        </LinearLayout>

        <LinearLayout android:id="@+id/game_carousel" android:layout_width="match_parent"
            android:layout_height="82dp" android:layout_marginTop="8dp"
            android:gravity="center" android:orientation="horizontal" android:clickable="true">
            <ImageView android:id="@+id/game_prev_icon" android:layout_width="58dp"
                android:layout_height="61dp" android:padding="0dp"
                android:src="@drawable/pubg_global"
                android:scaleType="fitCenter" android:contentDescription="Previous game"
                android:clickable="true" />
            <ImageView android:id="@+id/game_curr_icon" android:layout_width="96dp"
                android:layout_height="80dp" android:layout_marginHorizontal="15dp"
                android:padding="0dp" android:src="@drawable/pubg_india" android:scaleType="fitCenter"
                android:contentDescription="Selected game" android:clickable="true" />
            <ImageView android:id="@+id/game_next_icon" android:layout_width="58dp"
                android:layout_height="61dp" android:padding="0dp"
                android:src="@drawable/pubg_korea"
                android:scaleType="fitCenter" android:contentDescription="Next game"
                android:clickable="true" />
        </LinearLayout>
        <LinearLayout android:id="@+id/game_dots" android:layout_width="match_parent"
            android:layout_height="11dp" android:gravity="center"
            android:orientation="horizontal" />

        <LinearLayout android:id="@+id/dashboard_card" android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:padding="11dp" android:orientation="vertical"
            android:background="@drawable/dash_card">

            <LinearLayout android:id="@+id/dashboard_game_info_row" android:layout_width="match_parent" android:layout_height="58dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/main_game_icon" android:layout_width="55dp"
                    android:layout_height="55dp" android:padding="0dp" android:scaleType="fitCenter" android:src="@drawable/pubg_india"
                    android:contentDescription="Selected game icon" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView android:id="@+id/main_game_title" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:singleLine="true"
                        android:ellipsize="end" android:text="Game: BGMI" android:textColor="#FFFFFF"
                        android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:id="@+id/game_version" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="Version: —"
                        android:textColor="#AEBED5" android:textSize="11sp" android:singleLine="true" />
                    <TextView android:id="@+id/main_game_status" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="Status: —"
                        android:textColor="#65E1B8" android:textSize="10sp" android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- One stateful Install/Uninstall button; no duplicate actions. -->
            <LinearLayout android:id="@+id/dashboard_actions_row" android:layout_width="match_parent" android:layout_height="34dp"
                android:layout_marginTop="5dp" android:orientation="horizontal">
                <Button android:id="@+id/install_game" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1"
                    android:layout_marginEnd="6dp" android:background="@drawable/dash_primary" android:backgroundTint="@null"
                    android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                    android:singleLine="true" android:text="INSTALL" android:textAllCaps="false"
                    android:textSize="12sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="#FFFFFF" />
                <Button android:id="@+id/obb_fix" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1"
                    android:layout_marginStart="6dp" android:background="@drawable/dash_secondary" android:backgroundTint="@null"
                    android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                    android:singleLine="true" android:text="OBB FIX" android:textAllCaps="false"
                    android:textSize="12sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="#41CAFF" />
            </LinearLayout>

            <LinearLayout android:id="@+id/license_card" android:layout_width="match_parent"
                android:layout_height="49dp" android:layout_marginTop="7dp"
                android:paddingStart="9dp" android:paddingEnd="8dp" android:gravity="center_vertical"
                android:background="@drawable/dash_key" android:orientation="horizontal">
                <ImageView android:layout_width="21dp" android:layout_height="21dp"
                    android:src="@drawable/ic_dash_key" android:contentDescription="License icon" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginStart="9dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="License time remaining" android:textSize="10sp"
                        android:textColor="#A9C3BA" android:singleLine="true" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:id="@+id/days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00" android:textColor="#21EA9B" android:textStyle="bold" android:textSize="11sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="d  " android:textColor="#21EA9B" android:textSize="11sp"/>
                        <TextView android:id="@+id/hours" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00" android:textColor="#21EA9B" android:textStyle="bold" android:textSize="11sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="h  " android:textColor="#21EA9B" android:textSize="11sp"/>
                        <TextView android:id="@+id/minutes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00" android:textColor="#21EA9B" android:textStyle="bold" android:textSize="11sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="m  " android:textColor="#21EA9B" android:textSize="11sp"/>
                        <TextView android:id="@+id/seconds" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00" android:textColor="#21EA9B" android:textStyle="bold" android:textSize="11sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="s" android:textColor="#21EA9B" android:textSize="11sp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/license_key_value" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="Key: ••••••••"
                        android:textSize="10sp" android:singleLine="true" android:ellipsize="end"
                        android:textColor="#93C9B5" />
                </LinearLayout>
                <ImageButton android:id="@+id/license_eye" android:layout_width="30dp"
                    android:layout_height="36dp" android:background="@android:color/transparent"
                    android:padding="6dp" android:src="@drawable/ic_dash_eye"
                    android:contentDescription="Show or hide license key" />
            </LinearLayout>

            <LinearLayout android:id="@+id/dashboard_quick_row" android:layout_width="match_parent" android:layout_height="34dp"
                android:layout_marginTop="6dp" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="match_parent" android:layout_marginEnd="5dp"
                    android:background="@drawable/dash_glass" android:gravity="center_vertical"
                    android:paddingHorizontal="9dp">
                    <ImageView android:layout_width="17dp" android:layout_height="17dp"
                        android:src="@drawable/ic_dash_eye" android:contentDescription="" />
                    <TextView android:id="@+id/hide_esp_text" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content"
                        android:layout_marginStart="6dp" android:text="Hide ESP"
                        android:textColor="#EBF8FF" android:textSize="10sp" android:singleLine="true" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/hide_esp" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:minWidth="0dp" android:padding="0dp"
                        app:useMaterialThemeColors="false" app:thumbTint="#63D8FF"
                        app:trackTint="#445E78" />
                </LinearLayout>
                <Button android:id="@+id/clear_data" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="match_parent"
                    android:layout_marginStart="5dp" android:background="@drawable/dash_glass" android:backgroundTint="@null"
                    android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                    android:singleLine="true" android:text="↻  Reset Login"
                    android:textAllCaps="false" android:textColor="#F0F5FF" android:textSize="10sp" android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout android:id="@+id/device_card" android:layout_width="match_parent"
                android:layout_height="48dp" android:layout_marginTop="7dp"
                android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="15dp" android:layout_height="15dp"
                    android:src="@drawable/ic_dash_device" android:contentDescription="Device info icon" />
                <TextView android:id="@+id/device_info" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:gravity="center" android:maxLines="2" android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:text="Model · Android · RAM" android:textColor="#A7B8CF"
                    android:textSize="10sp" android:lineSpacingExtra="0dp" />
            </LinearLayout>

            <Button android:id="@+id/start_game" android:layout_width="match_parent"
                android:layout_height="44dp" android:layout_marginTop="7dp"
                android:background="@drawable/dash_primary" android:backgroundTint="@null" android:minHeight="0dp"
                android:singleLine="true" android:text="Start Game  ➜"
                android:textAllCaps="false" android:textSize="17sp"
                android:textStyle="bold" android:textColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btn_switch_mode"
                android:layout_width="match_parent" android:layout_height="35dp"
                android:minHeight="0dp" android:layout_marginTop="7dp"
               
                android:text="SELECT GAME MODE" android:textSize="10sp"
                android:textColor="#A7C7E9" app:backgroundTint="#C0122B43"
                app:cornerRadius="12dp" app:strokeWidth="1dp" app:strokeColor="#50CBFF"
                app:icon="@drawable/animation_play" app:iconPadding="8dp"
                app:iconSize="14dp" app:iconTint="#74BDEC" />
        </LinearLayout>

        <!-- Keep these IDs for the legacy adapter/progress code, but no hidden scroll. -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress" android:layout_width="match_parent"
            android:layout_height="3dp" android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerview" android:layout_width="match_parent"
            android:layout_height="0dp" android:visibility="gone" />
    </LinearLayout>
    <!-- Sign-in and account chip share the same original bottom position. -->
    <FrameLayout android:id="@+id/google_account_area"
        android:layout_width="match_parent" android:layout_height="62dp"
        android:layout_marginBottom="88dp" android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_gravity="bottom|center_horizontal">
        <ImageButton android:id="@+id/btn_google_sign_in"
            android:layout_width="58dp" android:layout_height="58dp"
            android:layout_gravity="center"
            android:padding="12dp" android:scaleType="fitCenter"
            android:background="@drawable/bg_google_round"
            android:src="@drawable/ic_google_g"
            android:contentDescription="Sign in with Google" />
        <LinearLayout android:id="@+id/google_profile_chip"
            android:layout_width="match_parent" android:layout_height="58dp"
            android:layout_gravity="center" android:visibility="gone"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="9dp" android:paddingEnd="10dp"
            android:background="@drawable/bg_google_profile_chip"
            android:clickable="true" android:focusable="true"
            android:contentDescription="Google account details and settings">
            <ImageView android:id="@+id/google_profile_avatar"
                android:layout_width="40dp" android:layout_height="40dp"
                android:padding="7dp" android:scaleType="centerCrop"
                android:src="@drawable/ic_google_g"
                android:background="@drawable/bg_google_round"
                android:contentDescription="Google profile picture" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:layout_marginStart="11dp"
                android:orientation="vertical">
                <TextView android:id="@+id/google_profile_name"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Google Connected" android:textSize="13sp"
                    android:textStyle="bold" android:textColor="#FFFFFF"
                    android:ellipsize="end" android:maxLines="1" />
                <TextView android:id="@+id/google_profile_email"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Account settings" android:textSize="10sp"
                    android:textColor="#AAD2F4" android:ellipsize="end" android:maxLines="1" />
            </LinearLayout>
            <TextView android:id="@+id/google_connected_indicator"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="●" android:textColor="#20E69D" android:textSize="19sp"
                android:contentDescription="Firebase connected" />
        </LinearLayout>
        <ProgressBar android:id="@+id/google_signin_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="34dp" android:layout_height="34dp"
            android:layout_gravity="center" android:visibility="gone"
            android:indeterminateTint="#23C6FF" />
    </FrameLayout>
</FrameLayout>
